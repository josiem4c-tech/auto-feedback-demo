
{
  "name": "auto-feedback-demo",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TEAM_DOMAIN": "https://tiny-forest-bb5f.cloudflareaccess.com",
    "POLICY_AUD": "039e1caaadda8094147d2d920802047ed7d882eecd29ed526adbe7c38b47b07b"
  },
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
